            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="logo">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="930"
                android:interpolator="@android:anim/linear_interpolator">
                <propertyValuesHolder
                    android:propertyName="scaleX"
                    android:valueType="floatType">
                    <keyframe android:fraction="0.0000" android:value="1" />
                    <keyframe android:fraction="0.7527" android:value="1" />
                    <keyframe android:fraction="0.8602" android:value="1.025" android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <keyframe android:fraction="1.0000" android:value="1" android:interpolator="@android:interpolator/fast_out_slow_in" />
