                android:duration="180"
                android:interpolator="@android:anim/linear_interpolator">
                <propertyValuesHolder
                    android:propertyName="fillAlpha"
                    android:valueType="floatType">
                    <keyframe android:fraction="0.0000" android:value="0" />
                    <keyframe android:fraction="1.0000" android:value="1" android:interpolator="@android:interpolator/fast_out_slow_in" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="stroke_top">
