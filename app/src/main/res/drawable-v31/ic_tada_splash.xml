                    android:valueType="floatType">
                    <keyframe android:fraction="0.0000" android:value="30" />
                    <keyframe android:fraction="0.1875" android:value="30" />
                    <keyframe android:fraction="1.0000" android:value="0" android:interpolator="@interpolator/splash_stroke" />
                </propertyValuesHolder>
                <propertyValuesHolder
                    android:propertyName="rotation"
                    android:valueType="floatType">
                    <keyframe android:fraction="0.0000" android:value="-24" />
                    <keyframe android:fraction="0.1875" android:value="-24" />
                    <keyframe android:fraction="1.0000" android:value="0" android:interpolator="@interpolator/splash_stroke" />
                </propertyValuesHolder>
                <propertyValuesHolder
                    android:propertyName="scaleX"
                    android:valueType="floatType">
                    <keyframe android:fraction="0.0000" android:value="0.55" />
                    <keyframe android:fraction="0.1875" android:value="0.55" />
                    <keyframe android:fraction="1.0000" android:value="1" android:interpolator="@interpolator/splash_stroke" />
                </propertyValuesHolder>
                <propertyValuesHolder
                    android:propertyName="scaleY"
                    android:valueType="floatType">
                    <keyframe android:fraction="0.0000" android:value="0.55" />
                    <keyframe android:fraction="0.1875" android:value="0.55" />
                    <keyframe android:fraction="1.0000" android:value="1" android:interpolator="@interpolator/splash_stroke" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="stroke_diagonal_path">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="300"
                android:interpolator="@android:anim/linear_interpolator">
                <propertyValuesHolder
                    android:propertyName="fillAlpha"
                    android:valueType="floatType">
                    <keyframe android:fraction="0.0000" android:value="0" />
