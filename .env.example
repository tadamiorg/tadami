# Optional local release signing. Copy to .env (gitignored) and fill in the values.
# Without a keystore, release builds are unsigned and debug builds use the default debug keystore.
# Real environment variables take precedence over this file. See docs/RELEASING.md.

# Path to the release keystore (absolute, or relative to app/). TADAMI_KEYSTORE_PATH also works.
SIGNING_KEY=
KEY_STORE_PASSWORD=
# Defaults to KEY_STORE_PASSWORD when empty
KEY_PASSWORD=
ALIAS=
